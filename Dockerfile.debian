# --- builder ---
FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

# --- runtime (Debian - 推荐，兼容性最好) ---
FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production \
    LOG_LEVEL=info \
    PROFILE_DIR=/data/profiles \
    OUTPUT_DIR=/data/output \
    CLOAK_HEADLESS=true \
    PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers

# 安装 Chromium 和 Playwright 依赖（添加重试机制）
# 添加 Xvfb 虚拟显示器支持（用于 Headed 模式扫码登录）
RUN apt-get update && \
    (apt-get install -y --no-install-recommends \
      chromium \
      chromium-sandbox \
      libnss3 \
      libatk1.0-0 \
      libatk-bridge2.0-0 \
      libcups2 \
      libdrm2 \
      libxkbcommon0 \
      libxcomposite1 \
      libxdamage1 \
      libxrandr2 \
      libgbm1 \
      libpango-1.0-0 \
      libcairo2 \
      libasound2 \
      libatspi2.0-0 \
      fonts-liberation \
      fonts-noto-cjk \
      # Xvfb 虚拟显示器（支持 Headed 模式扫码）
      xvfb \
      x11-utils \
    || (sleep 5 && apt-get install -y --no-install-recommends \
      chromium \
      chromium-sandbox \
      libnss3 \
      libatk1.0-0 \
      libatk-bridge2.0-0 \
      libcups2 \
      libdrm2 \
      libxkbcommon0 \
      libxcomposite1 \
      libxdamage1 \
      libxrandr2 \
      libgbm1 \
      libpango-1.0-0 \
      libcairo2 \
      libasound2 \
      libatspi2.0-0 \
      fonts-liberation \
      fonts-noto-cjk \
      xvfb \
      x11-utils)) \
    && rm -rf /var/lib/apt/lists/* \
    && chmod 4755 /usr/lib/chromium/chrome-sandbox

WORKDIR /app
COPY --from=builder /app/package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY --from=builder /app/dist ./dist
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# 数据目录（profile 与抓取产物）通过 volume 挂载持久化
VOLUME ["/data"]
EXPOSE 5510

# 使用 entrypoint 脚本启动（自动处理 Xvfb）
ENTRYPOINT ["/entrypoint.sh"]
