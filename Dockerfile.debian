# --- builder ---
FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

# --- browser extractor (根据构建平台选择对应的浏览器包) ---
FROM node:22-bookworm-slim AS browser-extractor
ARG TARGETARCH
WORKDIR /browser

# 复制所有架构的浏览器包到临时目录
COPY assets/ /tmp/assets/
COPY scripts/extract-browser.sh /extract-browser.sh
RUN chmod +x /extract-browser.sh

# 根据构建平台选择并解压对应的浏览器包
RUN if [ "$TARGETARCH" = "arm64" ]; then \
      echo "📦 选择 ARM64 浏览器包" && \
      cp /tmp/assets/cloakbrowser-linux-arm64.tar.gz /browser/browser.tar.gz; \
    elif [ "$TARGETARCH" = "amd64" ]; then \
      echo "📦 选择 x64 浏览器包" && \
      cp /tmp/assets/cloakbrowser-linux-x64.tar.gz /browser/browser.tar.gz; \
    else \
      echo "❌ 不支持的架构: $TARGETARCH" && exit 1; \
    fi

# 解压浏览器包到正确的位置
RUN TARGETARCH=$TARGETARCH /extract-browser.sh

# --- runtime (Debian - 推荐，兼容性最好) ---
FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production \
    LOG_LEVEL=info \
    PROFILE_DIR=/data/profiles \
    OUTPUT_DIR=/data/output \
    CLOAK_HEADLESS=true \
    CLOAK_BROWSER_PATH=/root/.cloakbrowser \
    CLOAKBROWSER_AUTO_UPDATE=false

# 安装 Chromium 和 Playwright 依赖（添加重试机制）
# 添加 Xvfb 虚拟显示器支持（用于 Headed 模式扫码登录）
RUN apt-get update && \
    (apt-get install -y --no-install-recommends \
      chromium \
      chromium-sandbox \
      libnss3 \
      libatk1.0-0 \
      libatk-bridge2.0-0 \
      libcups2 \
      libdrm2 \
      libxkbcommon0 \
      libxcomposite1 \
      libxdamage1 \
      libxrandr2 \
      libgbm1 \
      libpango-1.0-0 \
      libcairo2 \
      libasound2 \
      libatspi2.0-0 \
      fonts-liberation \
      fonts-noto-cjk \
      # Xvfb 虚拟显示器（支持 Headed 模式扫码）
      xvfb \
      x11-utils \
      # 截图工具（用于捕获二维码）
      scrot \
    || (sleep 5 && apt-get install -y --no-install-recommends \
      chromium \
      chromium-sandbox \
      libnss3 \
      libatk1.0-0 \
      libatk-bridge2.0-0 \
      libcups2 \
      libdrm2 \
      libxkbcommon0 \
      libxcomposite1 \
      libxdamage1 \
      libxrandr2 \
      libgbm1 \
      libpango-1.0-0 \
      libcairo2 \
      libasound2 \
      libatspi2.0-0 \
      fonts-liberation \
      fonts-noto-cjk \
      xvfb \
      x11-utils \
      scrot)) \
    && rm -rf /var/lib/apt/lists/* \
    && chmod 4755 /usr/lib/chromium/chrome-sandbox

WORKDIR /app
COPY --from=builder /app/package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY --from=builder /app/dist ./dist
COPY --from=browser-extractor /root/.cloakbrowser /root/.cloakbrowser
COPY scripts/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# 数据目录（profile 与抓取产物）通过 volume 挂载持久化
VOLUME ["/data"]
EXPOSE 5510

# 使用 entrypoint 脚本启动（自动处理 Xvfb）
ENTRYPOINT ["/entrypoint.sh"]
