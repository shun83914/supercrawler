# HTTP 服务端口
PORT=5510

# agent 鉴权 token（为空则不鉴权）
# Skills 钩子和服务端都使用此变量
SUPERCRAWLER_TOKEN=
API_TOKEN=${SUPERCRAWLER_TOKEN}

# 日志级别: trace|debug|info|warn|error
LOG_LEVEL=info

# CloakBrowser / Playwright 行为
CLOAK_HEADLESS=false
CLOAK_HUMANIZE=true
CLOAK_TIMEZONE=Asia/Shanghai
CLOAK_LOCALE=zh-CN
# CLOAK_PROXY=http://user:pass@host:8080

# 账号持久化 profile 目录 (每个 accountId 一个子目录)
PROFILE_DIR=./data/profiles

# JSONL 输出目录
OUTPUT_DIR=./data/output

# 抓取行为
XHS_SCRAPE_CONCURRENCY=1
XHS_MIN_DELAY_MS=800
XHS_MAX_DELAY_MS=2400
XHS_NAV_TIMEOUT_MS=45000
# 扫码登录最长等待 (毫秒)
XHS_LOGIN_WAIT_MS=300000

# 抖音抓取行为
DOUYIN_SCRAPE_CONCURRENCY=1
DOUYIN_MIN_DELAY_MS=1200
DOUYIN_MAX_DELAY_MS=3000
DOUYIN_NAV_TIMEOUT_MS=45000
DOUYIN_LOGIN_WAIT_MS=300000

# 幂等缓存 (避免 agent 重复调用打爆风控)
CACHE_TTL_MS=300000
CACHE_MAX_ENTRIES=256

# MCP
MCP_SSE_ENABLED=true
MCP_SSE_ENDPOINT=/mcp
